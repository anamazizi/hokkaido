# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project details
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Server-side service role key (for admin functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth Configuration (Required for /urus login)
# 1. Go to Supabase Dashboard > Authentication > Providers > Enable Google
# 2. Add Client ID & Secret from Google Cloud Console
# 3. Add redirect URL: http://localhost:3000/auth/callback
# 4. Ensure 'Google' provider is enabled

# Store coordinates for distance calculation (use actual store location)
NEXT_PUBLIC_STORE_LAT=4.1948617  # Example: Dapur latitude
NEXT_PUBLIC_STORE_LNG=100.6655929  # Example: Dapur longitude

# WhatsApp phone number for order notifications (include country code without +)
NEXT_PUBLIC_WHATSAPP_PHONE=601110890100